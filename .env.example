TIINGO_API_TOKEN=your_tiingo_api_token_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# MT5 dashboard stats (via Myfxbook) - optional, only needed if you want the
# MT5 account section on the dashboard. Connect your MT5 account(s) to
# Myfxbook yourself (myfxbook.com -> Portfolio -> Add Account -> MetaTrader 5
# -> "Auto Update", which is free and server-side) using the investor
# (read-only) password, never the full trading password. This is your real
# Myfxbook login, not a scoped token - keep it as private as any other
# password.
MYFXBOOK_EMAIL=your_myfxbook_login_email_here
MYFXBOOK_PASSWORD=your_myfxbook_login_password_here
