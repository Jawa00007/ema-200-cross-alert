TIINGO_API_TOKEN=your_tiingo_api_token_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# MT5 dashboard stats (via MetaApi.cloud) - optional, only needed if you want
# the MT5 account section on the dashboard. Provision each account in the
# MetaApi dashboard using its INVESTOR (read-only) password, never the full
# trading password.
METAAPI_TOKEN=your_metaapi_token_here
METAAPI_ACCOUNT_ID_1=your_first_metaapi_account_id_here
METAAPI_ACCOUNT_ID_2=your_second_metaapi_account_id_here
MT5_ACCOUNT_1_LABEL=Account 1
MT5_ACCOUNT_2_LABEL=Account 2
